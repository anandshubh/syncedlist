rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && memberDoc().hid == hid;
    }
    function isHead(hid) { return isMember(hid) && memberDoc().role == 'head'; }

    // ---- invite validation (used when a user redeems a code to join) ----
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }
    function validInvite(code, hid) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && invite(code).hid == hid
        && invite(code).role == 'member'
        && invite(code).revoked != true
        && (!('expiresAt' in invite(code)) || invite(code).expiresAt > request.time);
    }

    // ---- membership index (top-level; one household per person) ----
    match /members/{uid} {
      // you can read your own; a head can read the roster of their household
      allow read: if signedIn() && ( request.auth.uid == uid
                   || (isMember(resource.data.hid) && memberDoc().role == 'head') );
      // admin seeds heads; a user joins THEMSELVES only by redeeming a valid invite
      allow create: if isAdmin()
                   || ( request.auth.uid == uid
                        && request.resource.data.role == 'member'
                        && request.resource.data.hid is string
                        && validInvite(request.resource.data.viaInvite, request.resource.data.hid) );
      // a member can leave; a head can remove members of their household
      allow delete: if isAdmin()
                   || request.auth.uid == uid
                   || (isMember(resource.data.hid) && memberDoc().role == 'head');
      allow update: if isAdmin();
    }

    // ---- invite codes (head-managed, per household) ----
    match /invites/{code} {
      // a redeemer must be able to read the code doc by its (high-entropy) id
      allow read:   if signedIn();
      allow create: if isHead(request.resource.data.hid)
                     && request.resource.data.role == 'member';
      allow update, delete: if isHead(resource.data.hid);   // revoke / remove
    }

    // ---- all shopping data lives under the household ----
    match /households/{hid} {
      allow read:           if isMember(hid);
      allow create, delete: if isAdmin();     // only admin mints/removes households
      allow update:         if isHead(hid);   // rename

      match /config/{doc}     { allow read: if isMember(hid); allow write: if isHead(hid); } // stores + categories: head only
      match /list/{doc}       { allow read, write: if isMember(hid); }
      match /dictionary/{doc} { allow read, write: if isMember(hid); }
      match /staples/{doc}    { allow read, write: if isMember(hid); }
      match /purchased/{doc}  { allow read, write: if isMember(hid); }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
